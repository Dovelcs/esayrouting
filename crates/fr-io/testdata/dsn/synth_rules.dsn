(pcb synth_rules.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "7.0.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer In1.Cu (type power) (use_net GND) (property (index 1)))
    (layer In2.Cu (type signal) (rule (width 150) (clearance 180 (type wire_via))) (property (index 2)))
    (layer B.Cu (type signal) (property (index 3)))
    (boundary (path pcb 0  0 0  60000 0  60000 40000  0 40000  0 0))
    (boundary (rect signal 20000 20000 25000 25000))
    (keepout "" (polygon signal 0  1000 1000  3000 1000  3000 3000  1000 3000) (window (rect signal 1500 1500 2000 2000)) (clearance_class keepclass))
    (keepout "named" (rect B.Cu 4000 1000 5000 2000))
    (keepout (circle F.Cu 800 7000 1500))
    (via_keepout (rect In2.Cu 8000 1000 9000 2000))
    (place_keepout (rect F.Cu 10000 3000 11000 4000))
    (plane VCC (polygon B.Cu 0  30000 30000  50000 30000  50000 38000  30000 38000) (window (rect B.Cu 35000 32000 36000 33000)))
    (via "Via[0-3]_600:300_um" "Via[0-3]_800:400_um" (spare "Via[1-2]_500:250_um"))
    (control (via_at_smd on))
    (rule (width 250) (clearance 200) (clearance 100 (type smd_smd)) (clearance 50 (type smd_to_turn_gap)) (clearance 150 (type wire_via)) (clearance 120 (type default_keepclass)))
    (flip_style rotate_first)
    (snap_angle ninety_degree)
  )
  (placement
    (component "R_0603"
      (place R1 10000 10000 front 0 (PN 10k))
      (place R2 20000 10000 back 45 (pin 1 (clearance_class smdcls)) (keepout keepout_1 (clearance_class keepclass)))
      (place R3 30000 10000 front 270 (lock_type position))
      (place R4)
    )
    (component "DIP4"
      (place U1 40000 15000 back 90)
      (place U2 40000 25000 front 135.5)
    )
    (component "DIP4::2"
      (place U3 15000 30000 front 180)
    )
  )
  (library
    (image "R_0603"
      (outline (path signal 120  -1000 -500  1000 -500  1000 500  -1000 500  -1000 -500))
      (outline (path signal 50  -1200 -700  1200 -700))
      (outline (rect signal -1500 -900 1500 900))
      (outline (polyline_path signal 50  0 0 100 0  100 0 100 100))
      (keepout (rect F.Cu -300 -300 300 300))
      (keepout (circle signal 200 0 0))
      (via_keepout (rect signal -100 -100 100 100))
      (place_keepout (rect pcb -1000 -600 1000 600))
      (pin R_pad 1 -800 0)
      (pin R_pad (rotate 90) 2 800 0)
    )
    (image "DIP4"
      (side back)
      (pin Round_pad 1 -1270 -1270)
      (pin Round_pad 2 1270 -1270 (rotate 30))
      (pin Oblong_pad 3 1270 1270)
      (pin Poly_pad 4 -1270 1270)
    )
    (image "DIP4"
      (pin Round_pad 1 -1270 -1270)
      (pin Round_pad 2 1270 -1270 (rotate 30))
      (pin Oblong_pad 3 1270 1270)
      (pin Poly_pad 4 -1270 1270)
    )
    (image "DIP4"
      (pin Round_pad 1 -1270 -1270)
      (pin Round_pad 2 1270 -1270)
      (pin Oblong_pad 3 1270 1270)
      (pin Poly_pad 4 -1270 1270)
    )
    (padstack R_pad (shape (rect F.Cu -400 -450 400 450)) (attach off))
    (padstack Round_pad (shape (circle signal 1200)) (shape (circle In1.Cu 1500)))
    (padstack Oblong_pad (shape (path signal 800 -300 0 300 0)))
    (padstack Poly_pad (shape (polygon F.Cu 0  -500 -500  500 -500  0 0  500 500  -500 500)) (shape (polygon B.Cu 0  -500 -500  500 -500  500 500)))
    (padstack Degenerate_pad (shape (rect F.Cu 0 0 400 0)))
    (padstack Round_pad.1 (shape (circle signal 999)))
    (padstack "Via[0-3]_600:300_um" (shape (circle F.Cu 600)) (shape (circle In1.Cu 600)) (shape (circle In2.Cu 600)) (shape (circle B.Cu 600)) (attach off))
    (padstack "Via[0-3]_800:400_um" (shape (circle F.Cu 800)) (shape (circle In1.Cu 800)) (shape (circle In2.Cu 800)) (shape (circle B.Cu 800)) (attach on))
    (padstack "Via[1-2]_500:250_um" (shape (circle In1.Cu 500)) (shape (circle In2.Cu 500)))
  )
  (network
    (net GND (pins R1-1 R2-1 U1-1 U3-1))
    (net VCC (pins R1-2 U1-4 U2-4))
    (net SIG1 (order R2-2 U1-2 U2-2 U3-2))
    (net SIG2 (fromto U1-3 U2-3) (fromto U2-3 U3-3 R3-1) (rule (width 400)))
    (net "Net-(R3-2)" 3 (pins R3-2 U3-4) (rule (width 400) (clearance 99)))
    (net EMPTY)
    (via "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default)
    (via "V800" "Via[0-3]_800:400_um" smdcls attach)
    (via "V500" "Via[1-2]_500:250_um" unknowncls)
    (via_rule myrule "Via[0-3]_600:300_um" V800)
    (via_rule badrule "Via[0-3]_600:300_um" nothere)
    (class kicad_default "" GND
      (circuit (use_via "Via[0-3]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
    (class power VCC
      (clearance_class keepclass)
      (via_rule myrule)
      (circuit (use_via V500 "Via[0-3]_800:400_um") (use_layer F.Cu B.Cu) (length 50000 1000))
      (rule (width 500) (clearance 300) (clearance 250 (type smd_via)) (clearance 260 (type wire_area)))
      (layer_rule In2.Cu (rule (width 300) (clearance 310)))
      (pull_tight off)
      (shove_fixed on)
    )
    (class sig SIG1 SIG2
      (rule (width 200) (clearance 220))
    )
    (class_class (classes power sig kicad_default)
      (rule (clearance 400) (clearance 410 (type smd_pin)))
      (layer_rule B.Cu (rule (clearance 450)))
    )
  )
  (wiring
    (wire (path F.Cu 250  10800 10000  15000 10000  15000 12000) (net GND) (type protect))
    (wire (path B.Cu 250  12000 12000  12000 12000) (net GND))
    (wire (path B.Cu 250  12000 13000  12000 13000) (net GND) (type fix))
    (wire (path In2.Cu 250  1 1  2 2  900000 900000) (net GND))
    (wire (polyline_path F.Cu 200  20000 20000 21000 20000  21000 20000 21000 21000  21000 21000 22000 22000))
    (wire (polygon B.Cu 0  2000 30000  8000 30000  8000 36000  2000 36000) (window (rect B.Cu 3000 31000 4000 32000)) (net VCC))
    (wire (rect F.Cu 50000 5000 55000 9000) (net SIG2 0) (clearance_class keepclass))
    (wire (path Nope 250  0 0  1 1))
    (via "Via[0-3]_600:300_um" 15000 12000 (net GND) (type route))
    (via "Via[0-3]_600:300_um" 15000 12000 (net GND))
    (via "Via[0-3]_800:400_um" 16000 12000 (net SIG2) (clearance_class smdcls))
    (via "Via[1-2]_500:250_um.4" 17000 12000)
  )
)
