+/**
+ * Class used to cancel a performance critical algorithm after a time limit is exceeded.
+ *
+ * <p>PARITY BUILD. System property {@code freerouting.parity.timeLimitMode}:
+ *
+ * <ul>
+ *   <li>{@code wall} (default): original wall-clock behaviour.
+ *   <li>{@code disabled}: limits never fire (can loop forever on some boards).
+ *   <li>{@code count}: deterministic budget; the limit fires once {@code limitExceeded()} has been
+ *       called more than {@code timeLimit * factor} times on this instance, where factor is {@code
+ *       freerouting.parity.timeLimitFactor} (default 10). The Rust port implements the same rule,
+ *       so both sides stop at the same call.
+ * </ul>
+ *
+ * <p>The legacy flag {@code -Dfreerouting.parity.disableTimeLimits=true} selects {@code count}.
+ * The first time a limit fires (or would have fired in disabled mode) a PARITY_TIME_LIMIT line is
+ * printed to stderr.
+ */
 public class TimeLimit {
 
+  private static final String MODE = mode();
+  private static final long FACTOR = Long.getLong("freerouting.parity.timeLimitFactor", 10L);
+
   private final long timeStamp;
   private int timeLimit;
+  private long calls;
+  private boolean reported;
 
+  private static String mode() {
+    String m = System.getProperty("freerouting.parity.timeLimitMode");
+    if (m != null) {
+      return m;
+    }
+    return Boolean.getBoolean("freerouting.parity.disableTimeLimits") ? "count" : "wall";
+  }
+
   /** Creates a new instance with a time limit of milliSeconds milliseconds. */
